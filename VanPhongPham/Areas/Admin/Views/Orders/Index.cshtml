@using System.Globalization
@model List<Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var vi = new CultureInfo("vi-VN");
    var emails = (Dictionary<string,string>)ViewBag.Emails;
    var page = (int)ViewBag.Page;
    var pages = (int)ViewBag.Pages;
}
<h1 class="h3 mb-3">Quản lý đơn hàng</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><label class="form-label" for="status">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var st in Enum.GetValues<OrderStatus>()) {
                <option value="@st" selected="@(ViewBag.Status != null && (OrderStatus)ViewBag.Status == st)">@st</option>
            }
        </select></div>
    <div class="col-md-3"><label class="form-label" for="from">Từ ngày</label>
        <input id="from" name="from" type="date" class="form-control" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-3"><label class="form-label" for="to">Đến ngày</label>
        <input id="to" name="to" type="date" class="form-control" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Lọc đơn</button></div>
</form>
<div class="table-responsive"><table class="table table-hover">
<thead><tr><th>Mã đơn</th><th>Khách</th><th>Ngày</th><th>Thanh toán</th><th>Trạng thái</th><th class="text-end">Tổng</th><th></th></tr></thead>
<tbody>
@foreach (var o in Model) {
<tr><td>#@o.Id</td><td>@(emails.TryGetValue(o.UserId, out var email) ? email : o.UserId)</td>
<td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@o.PaymentMethod</td><td>@o.Status</td>
<td class="text-end">@o.Total.ToString("N0",vi)đ</td>
<td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@o.Id">Chi tiết</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng</td></tr> }
</tbody></table></div>
<nav aria-label="Phân trang đơn hàng"><div class="d-flex align-items-center gap-2">
<a class="btn btn-outline-secondary btn-sm @(page <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(page - 1)" asp-route-status="@ViewBag.Status" asp-route-from="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" asp-route-to="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))">Trước</a>
Trang @page / @pages
<a class="btn btn-outline-secondary btn-sm @(page >= pages ? "disabled" : "")" asp-action="Index" asp-route-page="@(page + 1)" asp-route-status="@ViewBag.Status" asp-route-from="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" asp-route-to="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))">Sau</a>
</div></nav>
