@using System.Globalization
@model List<Voucher>
@{
    ViewData["Title"] = "Quản lý voucher";
    var vi = new CultureInfo("vi-VN");
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h3 m-0">Quản lý voucher</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm voucher</a>
</div>
<form method="get" class="d-flex gap-2 mb-3">
    <input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm theo mã voucher" aria-label="Tìm mã" />
    <button class="btn btn-outline-primary">Tìm</button>
</form>
<div class="table-responsive"><table class="table table-hover">
<thead><tr><th>Mã</th><th>Loại</th><th>Giá trị</th><th>Hiệu lực</th><th>Đã dùng / Giới hạn</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
<tbody>
@foreach (var v in Model) {
<tr>
<td class="fw-bold">@v.Code</td><td>@v.Type</td>
<td>@(v.Type == VoucherType.Percent ? v.Value.ToString("N0",vi) + "%" : (v.Type == VoucherType.Shipping && v.Value == 0 ? "Miễn ship" : v.Value.ToString("N0",vi) + "đ"))</td>
<td>@v.StartAt.ToString("dd/MM/yyyy") – @v.EndAt.ToString("dd/MM/yyyy")</td>
<td>@v.UsedCount / @(v.TotalLimit?.ToString() ?? "∞")</td>
<td><span class="badge @(v.IsActive ? "bg-success" : "bg-secondary")">@(v.IsActive ? "Đang bật" : "Đã tắt")</span></td>
<td><div class="d-flex flex-wrap gap-1">
<a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
<a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Sửa</a>
<form asp-action="ToggleActive" asp-route-id="@v.Id" method="post">
@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-warning">@(v.IsActive ? "Tắt" : "Bật")</button>
</form>
<form asp-action="Delete" asp-route-id="@v.Id" method="post" onsubmit="return confirm('Chỉ xóa voucher chưa có lịch sử sử dụng. Tiếp tục?')">
@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Xóa</button>
</form></div></td>
</tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-muted text-center py-4">Không có voucher</td></tr> }
</tbody></table></div>
